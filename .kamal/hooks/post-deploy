#!/usr/bin/env bash
# 部署后验证服务健康，再清理冗余容器和镜像

echo "===== 服务器资源状态（部署前） ====="
for host in ${KAMAL_HOSTS//,/ }; do
  echo "
[$host] === 磁盘使用 ==="
  ssh "root@$host" "df -h / | tail -1"
  echo "[$host] === 内存使用 ==="
  ssh "root@$host" "free -h | grep Mem"
  echo "[$host] === CPU 负载 ==="
  ssh "root@$host" "uptime"
done

echo "===== 清理旧容器和镜像 ====="
for host in ${KAMAL_HOSTS//,/ }; do
  # 清理 voicebook staging 容器和镜像
  echo "[$host] 停止并移除 voicebook-staging 容器..."
  ssh "root@$host" "docker ps -aq --filter 'name=voicebook-staging' | xargs -r docker rm -f 2>/dev/null || true"
  ssh "root@$host" "docker images --filter 'reference=*voicebook-staging*' --format '{{.ID}}' | xargs -r docker rmi -f 2>/dev/null || true"
  # 清理 zheli_read staging 容器和镜像（同服务器共用）
  echo "[$host] 停止并移除 zheli_read-staging 容器..."
  ssh "root@$host" "docker ps -aq --filter 'name=zheli_read-staging' | xargs -r docker rm -f 2>/dev/null || true"
  ssh "root@$host" "docker images --filter 'reference=*zheli_read-staging*' --format '{{.ID}}' | xargs -r docker rmi -f 2>/dev/null || true"
  # 清理所有已停止的容器
  echo "[$host] 清理已停止的容器..."
  ssh "root@$host" "docker container prune -f"
  # 清理所有未使用的镜像
  echo "[$host] 清理未使用的镜像..."
  ssh "root@$host" "docker image prune -af --filter 'until=24h'"
  # 清理 Docker 系统缓存
  echo "[$host] 清理 Docker 系统缓存..."
  ssh "root@$host" "docker system prune -af --filter 'until=24h' && docker volume prune -af --filter 'until=24h'"
done

echo "===== 健康检查 ====="
for host in ${KAMAL_HOSTS//,/ }; do
  HEALTH_OK=false
  for i in $(seq 1 10); do
    STATUS=$(curl -s -o /dev/null -w "%{http_code}" https://api.zheliyuedu.cn/up 2>/dev/null)
    if [ "$STATUS" = "200" ]; then
      HEALTH_OK=true
      echo "[$host] 健康检查通过 (HTTP $STATUS)"
      break
    fi
    echo "[$host] 健康检查失败 (HTTP $STATUS)，等待 ${i}5 秒后重试..."
    sleep 5
  done
  if [ "$HEALTH_OK" != "true" ]; then
    echo "[$host] 警告: 部署后健康检查未通过，跳过清理"
    echo "[$host] 请手动检查: kamal app details"
    echo "[$host] 回滚命令: kamal app rollback"
    exit 1
  fi
done

echo "===== 服务器资源状态（部署后） ====="
for host in ${KAMAL_HOSTS//,/ }; do
  echo "
[$host] === 磁盘使用 ==="
  ssh "root@$host" "df -h / | tail -1"
  echo "[$host] === 内存使用 ==="
  ssh "root@$host" "free -h | grep Mem"
  echo "[$host] === Docker 磁盘使用 ==="
  ssh "root@$host" "docker system df"
  echo "[$host] === CPU 负载 ==="
  ssh "root@$host" "uptime"
done

echo "===== 部署完成 ====="

echo "===== 配置域名重定向（如未配置） ====="
for host in ${KAMAL_HOSTS//,/ }; do
  echo "[$host] 检查域名配置..."
  CURRENT_HOSTS=$(ssh "root@$host" "docker exec kamal-proxy kamal-proxy list 2>/dev/null | grep wandwords-web | awk '{print \$2}'" 2>/dev/null || echo "")
  if [[ "$CURRENT_HOSTS" != *"wanwords.com"* ]]; then
    echo "[$host] 未检测到 wanwords.com，配置域名重定向..."
    CONTAINER=$(ssh "root@$host" "docker ps --filter label=service=wandwords --filter label=role=web --format '{{.ID}}' | head -1")
    if [ -n "$CONTAINER" ]; then
      ssh "root@$host" "docker exec kamal-proxy kamal-proxy deploy wandwords-web --target='${CONTAINER}:80' --host='wanwords.com' --host='www.wanwords.com' --canonical-host='www.wanwords.com' --tls --deploy-timeout='120s' --drain-timeout='30s' --health-check-interval='5s' --health-check-timeout='10s' --health-check-path='/up' --target-timeout='60s' --buffer-requests --buffer-responses --tls-redirect"
      echo "[$host] 域名配置完成"
    else
      echo "[$host] 未找到 web 容器，跳过域名配置"
    fi
  else
    echo "[$host] 域名已配置，跳过"
  fi
done
